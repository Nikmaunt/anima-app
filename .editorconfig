root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 4

[*.{kt,kts}]
max_line_length = 120
# Composables are PascalCase functions; both engines must accept that.
ktlint_function_naming_ignore_when_annotated_with = Composable
# Wrapper scripts / convention plugins keep default package layout freedom.
ktlint_standard_filename = disabled
# Design tokens (AnimaPalette.night, .dawn, ...) are lowercase on purpose —
# they read as a vocabulary, not as constants.
ktlint_standard_property-naming = disabled
