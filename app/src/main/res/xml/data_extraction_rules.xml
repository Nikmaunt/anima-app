<?xml version="1.0" encoding="utf-8"?>
<!--
  The soul never leaves the device implicitly: every domain is excluded from
  both cloud backup and device-to-device transfer. The only way out is the
  explicit one-file soul export.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
