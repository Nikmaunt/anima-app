<?xml version="1.0" encoding="utf-8"?>
<!-- ADR-015: static App Shortcuts — Talk / Diary / Rest. Three of four
     launcher slots; deterministic statics first (no dynamic mood icon in
     v0.4). Actions are handled by MainActivity's action channel. -->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:shortcutId="talk"
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_talk"
        android:shortcutShortLabel="@string/shortcut_talk">
        <intent
            android:action="android.intent.action.MAIN"
            android:targetPackage="app.anima"
            android:targetClass="app.anima.MainActivity" />
    </shortcut>
    <shortcut
        android:shortcutId="diary"
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_diary"
        android:shortcutShortLabel="@string/shortcut_diary">
        <intent
            android:action="app.anima.action.DIARY"
            android:targetPackage="app.anima"
            android:targetClass="app.anima.MainActivity" />
    </shortcut>
    <shortcut
        android:shortcutId="rest"
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_rest"
        android:shortcutShortLabel="@string/shortcut_rest">
        <intent
            android:action="app.anima.action.REST"
            android:targetPackage="app.anima"
            android:targetClass="app.anima.MainActivity" />
    </shortcut>
</shortcuts>
