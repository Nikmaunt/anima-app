<?xml version="1.0" encoding="utf-8"?>
<!--
  v1.1c task 2.1: an EGG, not a body.

  This file used to be the spirit orb, and its own comment said so: "the first
  concept a new owner meets". It is also, on Android 12+, the system splash —
  so a phone whose creature is a fox showed a different creature full-screen at
  every launch, for longer than the one-frame flash that v1.1b removed.

  An adaptive icon is a static resource. It cannot follow a device seed, so any
  body drawn here is the wrong body for seven owners in eight, and before the
  first launch there is no body at all. What an icon CAN show is the thing that
  is true for everyone and is not yet anybody: the shell, with light already
  coming through the crack.

  Drawn inside the 66dp adaptive safe zone (centre 54,54, radius 33).
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- The light inside, leaking past the shell. -->
    <path android:pathData="M54,53m-30,0a30,30 0 1,0 60,0a30,30 0 1,0 -60,0z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="54"
                android:centerY="53"
                android:gradientRadius="30">
                <item android:offset="0.0" android:color="#4D8FD3C7" />
                <item android:offset="0.55" android:color="#1F8FD3C7" />
                <item android:offset="1.0" android:color="#008FD3C7" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- The shell: narrower at the top, the way an egg is. -->
    <path
        android:pathData="M54,28 C64.5,28 74,40.5 74,53 C74,65.5 65,74 54,74 C43,74 34,65.5 34,53 C34,40.5 43.5,28 54,28 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="40"
                android:startY="30"
                android:endX="68"
                android:endY="74">
                <item android:offset="0.0" android:color="#FFF2F5FF" />
                <item android:offset="0.62" android:color="#FFBFCCE6" />
                <item android:offset="1.0" android:color="#FF8496BC" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- The crack, as a shadow line… -->
    <path
        android:pathData="M54,30 L50.2,41.5 L56,47.5 L50.8,58 L56.4,63.6 L53.4,72.5"
        android:strokeColor="#663A4160"
        android:strokeWidth="3.4"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />
    <!-- …with the light coming through it. -->
    <path
        android:pathData="M54,30 L50.2,41.5 L56,47.5 L50.8,58 L56.4,63.6 L53.4,72.5"
        android:strokeColor="#FFDFF7F1"
        android:strokeWidth="1.6"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />
</vector>
