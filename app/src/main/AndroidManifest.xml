<?xml version="1.0" encoding="utf-8"?>
<!--
  Permission budget (ADR-004 as amended by ADR-005 and ADR-011), in full:
  - ACCESS_NETWORK_STATE, VIBRATE: normal install-time permissions, no dialogs.
  - INTERNET is declared by exactly two module manifests —
    :core:model-delivery (model bytes in: Play pack / user-initiated
    download) and :core:cloud-mind (the strictly opt-in BYOK cloud mind).
    No other module may declare it or touch network APIs in source;
    NetworkIsolationTest v3 fails the build otherwise (and fails loudly if
    the merged manifest is missing, closing the v0.1 vacuous-pass gap).
  - Notification Access is a special access granted on the system screen,
    strictly opt-in from an in-app explainer; the listener service lives in
    :feature:notifications with the system-held bind permission.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- v0.6: first real launcher icon (adaptive + monochrome; minSdk 31 ⇒
         no legacy PNGs) and predictive back opted in explicitly — no
         onBackPressed/BackHandler exists anywhere, so system animations are
         safe on 15/16 (Phase-3 sweep, this run). -->
    <application
        android:name=".AnimaApp"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:enableOnBackInvokedCallback="true"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:localeConfig="@xml/locales_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.Anima">

        <!--
          Strip DataTransport telemetry components (see note above).

          MissingClass is ignored on purpose. These are node="remove"
          directives, not declarations: their whole job is to delete a
          component IF some Play library merges it in. When no such library is
          on the classpath the removal is a harmless no-op, and lint's
          complaint that the class is absent is exactly the state we want.
          Dropping the directives would mean the telemetry comes back silently
          the day a dependency reintroduces it.

          v1.1 made this visible: removing :mind-pack from assetPacks took the
          Play asset-delivery chain off the debug classpath, so the classes
          stopped existing and lint started erroring.
        -->
        <service
            android:name="com.google.android.datatransport.runtime.scheduling.jobscheduling.JobInfoSchedulerService"
            tools:ignore="MissingClass"
            tools:node="remove" />
        <receiver
            android:name="com.google.android.datatransport.runtime.scheduling.jobscheduling.AlarmManagerSchedulerBroadcastReceiver"
            tools:ignore="MissingClass"
            tools:node="remove" />
        <service
            android:name="com.google.android.datatransport.runtime.backends.TransportBackendDiscovery"
            tools:ignore="MissingClass"
            tools:node="remove" />

        <!-- Soul export: one readable file handed to the share sheet. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <!-- ADR-015: static App Shortcuts (Talk / Diary / Rest). -->
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
