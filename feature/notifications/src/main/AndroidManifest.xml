<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <!--
          Not exported for anyone else — only the system holds
          BIND_NOTIFICATION_LISTENER_SERVICE. Access itself is granted by the
          user on the system Notification access screen (strict opt-in from
          the in-app explainer).
        -->
        <service
            android:name=".AnimaNotificationListener"
            android:exported="false"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
    </application>
</manifest>
