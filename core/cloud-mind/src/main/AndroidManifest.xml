<?xml version="1.0" encoding="utf-8"?>
<!--
  The SECOND and LAST module allowed to declare INTERNET (ADR-011; the
  first is :core:model-delivery, ADR-005). It merges into the app manifest;
  NetworkIsolationTest v3 asserts the permission originates from exactly
  these two module manifests and nowhere else. Traffic here happens ONLY
  when the user has explicitly enabled the cloud mind and supplied their
  own endpoint and key.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <!--
      v1.1: also declared here so `:core:cloud-mind:lintDebug` can see it on
      CloudMindEngine.kt:211, which checks whether the phone is online before
      trying. Previously only the app manifest carried it and the module lint
      errored; the failure predates v1.1 and was masked by Gradle's task
      cache. ACCESS_NETWORK_STATE is in NetworkIsolationTest's exact
      merged-permission allowlist, so the merged set does not change, and
      this module's INTERNET declaration above is still one of exactly two.
    -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
</manifest>
